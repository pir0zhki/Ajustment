rules_version = '2';

// 日程調整ツール用 Firestore セキュリティルール
// ・イベントは「URL（ID）を知っている人」だけが読める（一覧取得は禁止）
// ・イベントは作成のみ可。作成後の変更・削除は不可
// ・回答は誰でも作成・上書き可（同じ名前で上書きする簡易方式）。削除は不可
// ・項目と文字数を検証して、いたずらや巨大データの書き込みを防ぐ
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidEvent(d) {
      return d.keys().hasOnly(['title', 'creator', 'description', 'dates', 'startHour', 'endHour', 'createdAt'])
        && d.keys().hasAll(['title', 'creator', 'description', 'dates', 'startHour', 'endHour', 'createdAt'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && d.creator is string && d.creator.size() <= 50
        && d.description is string && d.description.size() <= 1000
        && d.dates is list && d.dates.size() >= 1 && d.dates.size() <= 90
        && d.startHour is int && d.endHour is int
        && d.startHour >= 0 && d.endHour <= 24 && d.startHour < d.endHour
        && d.createdAt == request.time;
    }

    function isValidResponse(d) {
      return d.keys().hasOnly(['name', 'comment', 'slots', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'comment', 'slots', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.comment is string && d.comment.size() <= 200
        && d.slots is map && d.slots.size() <= 2160   // 90日 × 24時間
        && d.updatedAt == request.time;
    }

    match /events/{eventId} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidEvent(request.resource.data);
      allow update, delete: if false;

      match /responses/{responseId} {
        allow read: if true;
        allow create: if isValidResponse(request.resource.data)
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/events/$(eventId));
        allow update: if isValidResponse(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }
  }
}
